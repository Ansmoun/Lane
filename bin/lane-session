#!/bin/sh
# bin/lane-session: wrapper de sesión de LANE.
# Uso: startx              (lee ~/.xinitrc que invoca este script)
#      startx /ruta/al/bin/lane-session

# Detectar la raiz del proyecto a partir de la ubicacion del script.
# Funciona tanto en desarrollo (~/proyectos/lane/bin/) como en
# produccion (/opt/lane/bin/).
SELF="$(readlink -f "$0")"
PROJECT="$(dirname "$(dirname "$SELF")")"
WM_CONF="$HOME/.config/lane/wm"
# Log por proceso: /tmp/lane-session-<pid>.log.
# Un archivo unico es fragil: dos sesiones en paralelo lo pisan, y
# si el archivo quedo de una corrida con sudo, ansmoun no puede
# escribir y el wrapper muere antes de arrancar.
LOG="/tmp/lane-session-$$.log"

# Todo lo que pase aqui queda en $LOG para depurar.
exec >"$LOG" 2>&1
echo "=== lane-session $(date) ==="
echo "PROJECT=$PROJECT"
echo "DISPLAY=$DISPLAY"
echo "DBUS=$DBUS_SESSION_BUS_ADDRESS"

# Limpieza de huerfanos (heredado de .xinitrc)
pkill -9 -x terminology 2>/dev/null
pkill -9 -x scrcpy 2>/dev/null

# D-Bus: sin esto apps que dependen de el entran en bucle
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -S "/run/user/$(id -u)/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
    echo "DBUS exportado: $DBUS_SESSION_BUS_ADDRESS"
fi

# XDG_RUNTIME_DIR: pipewire y wireplumber crean sus sockets y
# archivos de estado en este directorio. Sin el definido, pipewire
# falla silenciosamente o crea los sockets en /tmp, y los clientes
# no los encuentran.
if [ -z "$XDG_RUNTIME_DIR" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
    echo "XDG_RUNTIME_DIR exportado: $XDG_RUNTIME_DIR"
fi

# Servidor de audio.
#
# Void no arranca servicios de usuario automaticamente al entrar
# en una sesion X. Sin systemd ni elogind gestionando user units,
# hay que lanzar pipewire y wireplumber desde aqui.
#
# Orden estricto:
#   1. pipewire    -- crea el socket y publica los nodos basicos
#   2. wireplumber -- gestor de politicas, conecta a los dispositivos
#                     ALSA reales y publica los nodos al bus
#   3. pipewire-pulse (si esta) -- capa de compatibilidad que expone
#                     el protocolo PulseAudio sobre pipewire para
#                     clientes que no soportan pipewire nativo
#
# Los pgrep evitan duplicar procesos si el usuario ya los tiene
# corriendo por otros medios (por ejemplo, servicios de runit
# configurados a mano).

if ! pgrep -x pipewire >/dev/null 2>&1; then
    echo "--- arrancando pipewire ---"
    pipewire >/tmp/lane-pipewire.log 2>&1 &
    sleep 1
fi

if ! pgrep -x wireplumber >/dev/null 2>&1; then
    echo "--- arrancando wireplumber ---"
    wireplumber >/tmp/lane-wireplumber.log 2>&1 &
    sleep 1
fi

if command -v pipewire-pulse >/dev/null 2>&1; then
    if ! pgrep -x pipewire-pulse >/dev/null 2>&1; then
        echo "--- arrancando pipewire-pulse ---"
        pipewire-pulse >/tmp/lane-pipewire-pulse.log 2>&1 &
        sleep 1
    fi
fi

# pulseaudio y pipewire no pueden coexistir. Ambos publican el
# socket pulse en $XDG_RUNTIME_DIR/pulse/native, y los clientes
# se conectan a uno u otro de forma impredecible. Si pulseaudio
# quedo vivo de una sesion previa, matarlo.
if pgrep -x pulseaudio >/dev/null 2>&1; then
    echo "--- matando pulseaudio (conflicto con pipewire) ---"
    pkill -x pulseaudio
    sleep 1
fi

echo "--- estado de audio tras arranque ---"
for p in pipewire wireplumber pipewire-pulse pulseaudio; do
    if pgrep -x "$p" >/dev/null 2>&1; then
        echo "  $p: corriendo"
    fi
done

# Autostart del toolkit. NO usa set -e: si falla, seguimos al WM.
# Configurar monitores ANTES del autostart. Inline para no pagar
# los sleeps del script externo (los sleeps son para hotplug, no
# para el arranque inicial). wait_x ya garantizo que X responde.
echo "--- xrandr ---"
if xrandr --query | grep -q "^VGA-1 connected"; then
    xrandr --output VGA-1  --mode 1024x768 --rate 75.03 --pos 0x0 \
           --output LVDS-1 --mode 1024x600             --pos 0x768
else
    xrandr --output VGA-1  --off \
           --output LVDS-1 --mode 1024x600 --pos 0x0
fi
echo "xrandr exit=$?"
xrandr --query | grep connected

cd "$PROJECT" || { echo "cd $PROJECT fallo"; exit 1; }
echo "--- ejecutando autostart ---"
./run apps/autostart.lua
echo "autostart exit=$?"

# Elegir WM, en orden de prioridad:
#   1. /tmp/lane-wm-choice -- lo escribe el greeter antes de autenticar
#   2. ~/.config/lane/wm  -- persistente
#   3. default: bspwm
#
# Caso especial: si el id elegido es "LANE", significa que el
# usuario eligio la entrada LANE del greeter (nuestro .desktop en
# ~/.local/share/xsessions/). En ese caso no hay que exec "LANE":
# se usa el WM persistido en ~/.config/lane/wm.
TMP_WM="/tmp/lane-wm-choice"
if [ -f "$TMP_WM" ]; then
    WM=$(head -1 "$TMP_WM" | tr -d '[:space:]')
    rm -f "$TMP_WM"
    if [ "$WM" = "LANE" ]; then
        echo "greeter eligio LANE, usando WM persistido"
        if [ -f "$WM_CONF" ]; then
            WM=$(head -1 "$WM_CONF" | tr -d '[:space:]')
        else
            WM="bspwm"
        fi
    else
        mkdir -p "$(dirname "$WM_CONF")"
        echo "$WM" > "$WM_CONF"
        echo "WM elegido por greeter: $WM (persistido en $WM_CONF)"
    fi
elif [ -f "$WM_CONF" ]; then
    WM=$(head -1 "$WM_CONF" | tr -d '[:space:]')
fi
[ -z "$WM" ] && WM="bspwm"
echo "--- exec $WM ---"
exec "$WM"
